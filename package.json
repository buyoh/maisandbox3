{
  "name": "maisandbox3",
  "private": true,
  "main": "/dev/null",
  "scripts": {
    "dev": "tsc --project tsconfig.server.json --noEmit && ts-node --swc --project tsconfig.server.json src/app/main-server.ts",
    "prod": "FRONTEND=static NODE_ENV=production node --import ./prod/register.mjs build/app/main-server.js",
    "build": "tsc --project tsconfig.server.json --noEmit && npm run build-vite && npm run build-server",
    "build-vite": "vite build",
    "build-server": "swc src/app -d build --copy-files --strip-leading-paths",
    "proto-gen": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --ts_proto_opt=outputServices=grpc-js --ts_proto_opt=esModuleInterop=true src/proto/launcher.proto",
    "proto-gen-go": "cd deps/applauncher-go && make proto",
    "proto-gen-all": "npm run proto-gen && npm run proto-gen-go",
    "test": "jest --coverage --selectProjects server web",
    "test-e2e": "jest --selectProjects e2e",
    "test-update": "jest --updateSnapshot",
    "lint": "prettier --check 'src/**/*.ts' 'src/**/*.tsx' && eslint src/**/*.ts src/**/*.tsx",
    "lint-fix": "prettier --write 'src/**/*.ts' 'src/**/*.tsx'"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.0",
    "ace-builds": "~1.36.5",
    "express": "^4.21.1",
    "jotai": "^2.20.1",
    "react": "^18.3.1",
    "react-ace": "~13.0.0",
    "react-dom": "^18.3.1",
    "sass": "^1.80.6",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@testing-library/react": "^14.3.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^28.1.1",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.9.5",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-proto": "^1.176.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.4"
  }
}
