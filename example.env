# サーバ設定

# HTTPサーバのポート番号 (デフォルト: 11460)
PORT=11460

# 実行環境 (production / development)
# NODE_ENV=production

# Launcher の動作モード
# grpc: 外部 gRPC サーバに接続
# grpc-child: gRPC Launcher を子プロセスとして起動 (デフォルト)
# LAUNCHER_MODE=grpc-child

# gRPC Launcher のアドレス (LAUNCHER_MODE=grpc 時に使用, デフォルト: localhost:50051)
# LAUNCHER_GRPC_ADDRESS=localhost:50051
# Unix ドメインソケットを使用する場合は以下のように指定 (LAUNCHER_MODE=grpc 時に使用)
# LAUNCHER_GRPC_ADDRESS=unix:///var/opt/msb/launcher-grpc.sock

# grpc-child モード時に go run で直接実行する (開発用, LAUNCHER_GRPC_BINARY より優先)
LAUNCHER_GRPC_GORUN=true

# grpc-child モード時に使用する Launcher バイナリパス (未設定時は build/launcher を使用)
LAUNCHER_GRPC_BINARY=./deps/applauncher-go/build/launcher

# Launcher の Go ソースディレクトリ (デフォルト: deps/applauncher-go)
# LAUNCHER_GRPC_DIR=deps/applauncher-go

# Launcher の設定ファイルディレクトリ
# grpc-child モードのとき、./deps/applauncher-go からの相対パスとなる
LAUNCHER_CONFIGS_DIR=./internal/default-configs

# SSL設定ファイルのパス (未設定で無効)
# SSL_CONFIG_PATH=/path/to/ssl-config

# フロントエンド配信方式 (vite: 開発用HMR / static: ビルド済み静的ファイル)
# FRONTEND=vite
